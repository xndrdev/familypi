# Kopieren nach /opt/familydisplay/familydisplay.env und anpassen (chmod 600!).

FD_ADDR=:8080
FD_DB=/opt/familydisplay/data/family.db
FD_STATIC_DIR=/opt/familydisplay/public
FD_TZ=Europe/Berlin

# Passwort fuer die Verwaltung (Web UI). Leer lassen = jeder im WLAN darf aendern.
FD_ADMIN_TOKEN=

# Optional: Token fuer den abonnierbaren Kalender (?token=...)
FD_ICS_TOKEN=

# Wie oft externe Kalender (Google/iCloud) neu geladen werden
FD_CALENDAR_REFRESH=15m

# Wetter von Open-Meteo (kostenlos, kein Key). Ortsname ODER Koordinaten, leer = aus.
FD_WEATHER_PLACE=
# FD_WEATHER_LAT=51.34
# FD_WEATHER_LON=12.37

# Discord-Bot (siehe README). Ohne Token laeuft alles ausser dem Bot.
FD_DISCORD_TOKEN=
FD_DISCORD_GUILD_ID=
